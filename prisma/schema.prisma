generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  FOOTBALL
  CRICKET
  BADMINTON
  BASKETBALL
  PADEL
  TENNIS
}

enum MatchStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  JOINED
  CHECKED_IN
  LATE_CANCEL
  GHOSTED
}

enum TeamSide {
  TEAM_A
  TEAM_B
  UNASSIGNED
}

enum SwipeType {
  INVITE
  PASS
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  phone            String?             @unique
  name             String
  avatarUrl        String?
  bio              String?
  city             String              @default("Delhi")
  locality         String
  reliabilityScore Int                 @default(100)
  ghostCount       Int                 @default(0)
  cooldownUntil    DateTime?
  createdAt        DateTime            @default(now())
  sportRatings     PlayerSportRating[]
  hostedMatches    Match[]             @relation("MatchHost")
  participations   MatchParticipant[]
  swipesSent       SwipeAction[]       @relation("Swiper")
  swipesReceived   SwipeAction[]       @relation("TargetUser")
  clanMemberships  ClanMember[]
}

model PlayerSportRating {
  id             String   @id @default(cuid())
  userId         String
  sport          Sport
  eloRating      Int      @default(1200)
  matchesPlayed  Int      @default(0)
  wins           Int      @default(0)
  losses         Int      @default(0)
  draws          Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, sport])
}

model Turf {
  id                 String   @id @default(cuid())
  name               String   @unique
  city               String
  locality           String
  address            String
  latitude           Float
  longitude          Float
  photos             String[]
  isPartnerVerified  Boolean  @default(false)
  totalMatchesHosted Int      @default(0)
  pricePerHour       Int
  supportedSports    Sport[]
  amenities          String[]
  matches            Match[]
}

model Match {
  id              String             @id @default(cuid())
  turfId          String
  hostId          String
  sport           Sport
  startTime       DateTime
  durationMinutes Int                @default(60)
  minElo          Int                @default(800)
  maxElo          Int                @default(2000)
  minReliability  Int                @default(70)
  maxPlayers      Int
  pricePerPlayer  Int
  status          MatchStatus        @default(OPEN)
  teamAScore      Int?
  teamBScore      Int?
  createdAt       DateTime           @default(now())
  turf            Turf               @relation(fields: [turfId], references: [id])
  host            User               @relation("MatchHost", fields: [hostId], references: [id])
  participants    MatchParticipant[]
}

model MatchParticipant {
  id               String           @id @default(cuid())
  matchId          String
  userId           String
  team             TeamSide         @default(UNASSIGNED)
  attendanceStatus AttendanceStatus @default(JOINED)
  eloBefore        Int
  eloAfter         Int?
  joinedAt         DateTime         @default(now())
  match            Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([matchId, userId])
}

model SwipeAction {
  id           String    @id @default(cuid())
  swiperId     String
  targetUserId String
  sport        Sport
  action       SwipeType
  isMatch      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  swiper       User      @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  targetUser   User      @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  @@unique([swiperId, targetUserId, sport])
}

model Clan {
  id          String       @id @default(cuid())
  name        String       @unique
  city        String
  locality    String
  avatarUrl   String?
  bannerUrl   String?
  description String?
  aggregateElo Int         @default(1200)
  createdAt   DateTime     @default(now())
  members     ClanMember[]
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  clan     Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([clanId, userId])
}
